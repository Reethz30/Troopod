          "id": "tier_product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "tier_product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "tier_product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "tier_product_5",
          "label": "Product 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "qty": "2",
