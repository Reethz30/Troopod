{% render 'purelane-assets' %}

<div class="purelane">
  <section class="sec" id="bundles" data-scene="3">
    <div class="wrap">
      <div class="glass sec-pad rv" style="margin-bottom:16px">
        <div class="panel-head" style="margin-bottom:0">
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.lede != blank -%}
            <p class="lede" style="margin:0 auto">{{ section.settings.lede | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="tiers">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tier' -%}
            {%- liquid
              assign tier_class = 'glass tier rv'
              if block.settings.highlight
                assign tier_class = 'glass tier best rv'
              endif
              assign btn_class = 'btn btn-ghost'
              if block.settings.highlight
                assign btn_class = 'btn btn-primary'
              endif
              assign pix_count = 0
              if block.settings.tier_product_1 != blank
                assign pix_count = pix_count | plus: 1
              endif
              if block.settings.tier_product_2 != blank
                assign pix_count = pix_count | plus: 1
              endif
              if block.settings.tier_product_3 != blank
                assign pix_count = pix_count | plus: 1
              endif
              if block.settings.tier_product_4 != blank
                assign pix_count = pix_count | plus: 1
              endif
              if block.settings.tier_product_5 != blank
                assign pix_count = pix_count | plus: 1
              endif
            -%}
            <article class="{{ tier_class }}{% if forloop.index == 2 %} rv-d2{% elsif forloop.index == 3 %} rv-d3{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.tag != blank -%}
                <span class="tag">{{ block.settings.tag | escape }}</span>
              {%- endif -%}

              {%- if pix_count > 0 -%}
                <div class="tierpix{% if pix_count >= 5 %} five{% endif %}" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    {%- liquid
                      case i
                        when 1
                          assign tp = block.settings.tier_product_1
                        when 2
                          assign tp = block.settings.tier_product_2
                        when 3
                          assign tp = block.settings.tier_product_3
                        when 4
                          assign tp = block.settings.tier_product_4
                        when 5
                          assign tp = block.settings.tier_product_5
                      endcase
                    -%}
                    {%- if tp != blank and tp.featured_image != blank -%}
                      <img
                        class="pimg"
                        src="{{ tp.featured_image | image_url: width: 200 }}"
                        alt=""
                        width="54"
                        height="70"
                        loading="lazy"
                      >
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="qty">
                {{ block.settings.qty | default: '3' | escape }}
                <small>{{ block.settings.qty_label | default: 'Products' | escape }}</small>
              </div>
              <div class="price">
                {{ block.settings.price | escape }}
                {%- if block.settings.compare_at != blank -%}
                  <s>{{ block.settings.compare_at | escape }}</s>
                {%- endif -%}
              </div>
              {%- if block.settings.per_product_note != blank -%}
                <p class="body-s" style="font-size:12px">{{ block.settings.per_product_note | escape }}</p>
              {%- endif -%}
              {%- if block.settings.features != blank -%}
                <ul>
                  {%- assign feature_lines = block.settings.features | newline_to_br | split: '<br />' -%}
                  {%- for line in feature_lines -%}
                    {%- assign clean = line | strip_html | strip -%}
                    {%- if clean != blank -%}
                      <li>
                        {% render 'purelane-icon', icon: 'check' %}
                        {{ clean | escape }}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              <a class="{{ btn_class }}" href="{{ block.settings.button_link | default: '#shop' }}">
                {{ block.settings.button_label | default: 'Build this box' | escape }}
                {%- if block.settings.highlight -%}
                  {% render 'purelane-icon', icon: 'arrow' %}
                {%- endif -%}
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "div",
  "class": "section-purelane-bundles",
  "settings": [
