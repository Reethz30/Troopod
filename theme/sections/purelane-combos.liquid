{% render 'purelane-assets' %}

<div class="purelane">
  <section class="sec" id="combos" data-scene="3">
    <div class="wrap">
      <div class="panel-head rv">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {% render 'purelane-rule' %}
        {%- if section.settings.lede != blank -%}
          <p class="lede" style="margin:14px auto 0">{{ section.settings.lede | escape }}</p>
        {%- endif -%}
      </div>

      <div class="comborail rv">
        {%- for block in section.blocks -%}
          {%- if block.type == 'combo' -%}
            {%- liquid
              assign combo_class = 'glass combo'
              if block.settings.highlight
                assign combo_class = combo_class | append: ' hero-combo'
              endif
              assign btn_class = 'btn btn-ghost'
              if block.settings.highlight
                assign btn_class = 'btn btn-primary'
              endif
            -%}
            <article class="{{ combo_class }}" {{ block.shopify_attributes }}>
              <div class="tray">
                {%- if block.settings.save_label != blank -%}
                  <span class="save">{{ block.settings.save_label | escape }}</span>
                {%- endif -%}
                {%- if block.settings.flag != blank -%}
                  <span class="flag">{{ block.settings.flag | escape }}</span>
                {%- endif -%}
                <div class="stack">
                  {%- assign shown = 0 -%}
                  {%- for i in (1..3) -%}
                    {%- liquid
                      case i
                        when 1
                          assign item_product = block.settings.item_1_product
                          assign item_caption = block.settings.item_1_caption
                          assign item_bottle = block.settings.item_1_bottle | default: 'none'
                        when 2
                          assign item_product = block.settings.item_2_product
                          assign item_caption = block.settings.item_2_caption
                          assign item_bottle = block.settings.item_2_bottle | default: 'none'
                        when 3
                          assign item_product = block.settings.item_3_product
                          assign item_caption = block.settings.item_3_caption
                          assign item_bottle = block.settings.item_3_bottle | default: 'none'
                      endcase
                    -%}
                    {%- if item_product != blank or item_caption != blank or item_bottle != 'none' -%}
                      {%- if shown > 0 -%}
                        <span class="plus" aria-hidden="true">+</span>
                      {%- endif -%}
                      <span class="it">
                        {%- if item_product != blank and item_product.featured_image != blank -%}
                          <img
                            class="pimg"
                            src="{{ item_product.featured_image | image_url: width: 240 }}"
                            alt="{{ item_product.title | escape }}"
                            width="80"
                            height="100"
                            loading="lazy"
                          >
                        {%- elsif item_bottle != blank and item_bottle != 'none' -%}
                          <span class="pimg p-{{ item_bottle }}" role="img" aria-label="{{ item_caption | default: item_bottle | escape }}"></span>
                        {%- else -%}
                          <span class="tile">{% render 'purelane-icon', icon: 'leaf' %}</span>
                        {%- endif -%}
                        {%- if item_caption != blank -%}
                          <span>{{ item_caption | escape }}</span>
                        {%- elsif item_product != blank -%}
                          <span>{{ item_product.title | escape }}</span>
                        {%- endif -%}
                      </span>
                      {%- assign shown = shown | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
              <div class="body">
                {%- if block.settings.title != blank -%}
                  <h3>{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.product_count_label != blank -%}
                  <div class="cnt">{{ block.settings.product_count_label | escape }}</div>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="inc">{{ block.settings.description | escape }}</p>
                {%- endif -%}
                <div class="prow">
                  {%- if block.settings.price != blank -%}
                    <strong>{{ block.settings.price | escape }}</strong>
                  {%- endif -%}
                  {%- if block.settings.compare_at != blank -%}
                    <s>{{ block.settings.compare_at | escape }}</s>
                  {%- endif -%}
                  {%- if block.settings.save_em != blank -%}
                    <em>{{ block.settings.save_em | escape }}</em>
                  {%- elsif block.settings.save_label != blank -%}
                    <em>{{ block.settings.save_label | escape }}</em>
                  {%- endif -%}
                </div>
                {%- if block.settings.fine_print != blank -%}
                  <div class="fine">{{ block.settings.fine_print | escape }}</div>
                {%- endif -%}
                <a class="{{ btn_class }}" href="{{ block.settings.button_link | default: '#bundles' }}">
                  {{ block.settings.button_label | default: 'Shop bundle' | escape }}
                  {% render 'purelane-icon', icon: 'arrow' %}
                </a>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.swipe_cue != blank -%}
        <div class="swipecue" aria-hidden="true">
          {% render 'purelane-icon', icon: 'arrow' %}
          {{ section.settings.swipe_cue | escape }}
        </div>
      {%- endif -%}
      {%- if section.settings.rail_note != blank -%}
        <p class="railnote">{{ section.settings.rail_note | escape }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

