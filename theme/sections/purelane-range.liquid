{% render 'purelane-assets' %}

<div class="purelane">
  <section class="sec" id="range" data-scene="3">
    <div class="wrap">
      <div class="glass range rv">
        <div class="range-head">
          <div>
            <span class="kicker">The full range</span>
            <h2 class="d2" style="margin-top:10px">Every room, one shelf</h2>
          </div>
          <p class="body-s" style="max-width:34ch;margin-bottom:4px">Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink.</p>
        </div>
        <div class="stripwrap">
          <div class="rangerow">
            <span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner"></span>
            <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span>
            <span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
            <span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span>
            <span class="pimg p-laundry" role="img" aria-label="Purelane natural laundry detergent"></span>
            <span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel"></span>
            <span class="pimg p-metal" role="img" aria-label="Purelane copper, bronze and brass cleaner"></span>
            <span class="pimg p-wm" role="img" aria-label="Purelane washing machine cleaner and descaler"></span>
            <span class="pimg p-handwash" role="img" aria-label="Purelane gentle hydrating liquid handwash"></span>
            <span class="pimg p-eraser" role="img" aria-label="Purelane magic eraser"></span>
          </div>
        </div>
        <p class="striphint">Swipe to see the full shelf</p>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Purelane full range",
  "tag": "div",
  "class": "section-purelane-range",
  "settings": [],
  "presets": [
    {
      "name": "Purelane full range"
    }
  ]
}
{% endschema %}
