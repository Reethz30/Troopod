{% render 'purelane-assets' %}

<div class="purelane">
  <section class="sec revband" id="reviews" data-scene="1">
    <div class="wrap">
      <div class="revhead rv">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        <span class="agg">
          <span class="st" aria-hidden="true">★★★★★</span>
          {%- if section.settings.rating_text != blank -%}
            <b>{{ section.settings.rating_text | escape }}</b>
          {%- endif -%}
          {%- if section.settings.reviews_count_label != blank -%}
            {{ section.settings.reviews_count_label | escape }}
          {%- endif -%}
        </span>
        {%- if section.settings.homes_label != blank -%}
          <span class="agg">{{ section.settings.homes_label }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="revrail rv" aria-label="{{ section.settings.rail_label | default: 'Customer reviews' | escape }}">
      <div class="revtrack">
        {%- for pass in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              {%- assign star_count = block.settings.stars | default: 5 -%}
              <article class="glass-2 rcard"{% if pass == 1 %} {{ block.shopify_attributes }}{% endif %}>
                <div class="st" aria-label="{{ star_count }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= star_count -%}★{%- else -%}☆{%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.title != blank -%}
                  <h5>{{ block.settings.title | escape }}</h5>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p>{{ block.settings.body | escape }}</p>
                {%- endif -%}
                <div class="who">
                  {% render 'purelane-icon', icon: 'check' %}
                  {%- if block.settings.author != blank -%}
                    <b>{{ block.settings.author | escape }}</b>
                  {%- endif -%}
                  {%- if block.settings.product_label != blank -%}
                    <span>· {{ block.settings.product_label | escape }}</span>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "div",
  "class": "section-purelane-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Aggregate rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "reviews_count_label",
      "label": "Reviews count label",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "html",
      "id": "homes_label",
      "label": "Homes label",
      "default": "Loved by <b>12 lakh+</b> homes"
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Rail aria-label",
      "default": "Customer reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_label",
          "label": "Product label",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "title": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product_label": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "title": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_label": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "title": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_label": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "title": "Dog friendly",
            "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_label": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "title": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product_label": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
