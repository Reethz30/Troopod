{% render 'purelane-assets' %}

{%- liquid
  assign shelf_products = section.settings.product_list
  if shelf_products == blank or shelf_products.size == 0
    if section.settings.collection != blank
      assign shelf_products = section.settings.collection.products
    endif
  endif
  assign limit = section.settings.products_to_show | default: 8
-%}

<div class="purelane">
  <section class="sec" id="shop" data-scene="3">
    <div class="wrap">
      <div class="panel-head rv">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {% render 'purelane-rule' %}
      </div>

      <div class="shelf">
        {%- if shelf_products != blank and shelf_products.size > 0 -%}
          {%- for product in shelf_products limit: limit -%}
            {% render 'purelane-product-card', product: product, section: section %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <article class="glass card rv">
              <div class="shot">
                <span class="pill">Sample</span>
                <span class="pimg pl-placeholder" role="img" aria-label="Placeholder product"></span>
              </div>
              <h4>Add products in the theme editor</h4>
              <div class="rate"><b>★ 4.8</b> · — reviews</div>
              <div class="pr"><strong>—</strong></div>
              <button type="button" class="btn btn-ghost btn-sm" disabled>Add to cart</button>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Purelane shop",
  "tag": "div",
  "class": "section-purelane-shop",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 8
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection fallback",
      "info": "Used when the product list is empty."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane shop"
    }
  ]
}
{% endschema %}
