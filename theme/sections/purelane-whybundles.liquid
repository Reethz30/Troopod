{% render 'purelane-assets' %}

<div class="purelane">
  <!-- Why bundles -->
  <section class="sec" id="whybundles" data-scene="4">
    <div class="wrap">
      <div class="glass sec-pad rv">
        <div class="panel-head">
          <span class="kicker">The smarter way to shop</span>
          <h2 class="d2" style="margin-top:12px">Why bundles beat buying single</h2>
          {% render 'purelane-rule' %}
        </div>
        <div class="wb">
          <div class="wb-i">
            <span class="ci">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg>
            </span>
            <h4>Save up to 45%</h4>
            <p>Versus buying the same products separately</p>
          </div>
          <div class="wb-i">
            <span class="ci">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3.4"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/></svg>
            </span>
            <h4>One flat price</h4>
            <p>No calculators, no comparing carts</p>
          </div>
          <div class="wb-i">
            <span class="ci">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg>
            </span>
            <h4>Curated by experts</h4>
            <p>Products picked to work well together</p>
          </div>
          <div class="wb-i">
            <span class="ci">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 16.4V7.2h10.2v9.2"/><path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/><circle cx="6.6" cy="18" r="1.9"/><circle cx="16.6" cy="18" r="1.9"/></svg>
            </span>
            <h4>Free shipping always</h4>
            <p>Included on every bundle, all India</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="sec" id="categories" data-scene="4">
    <div class="wrap">
      <div class="panel-head rv">
        <span class="kicker">Bundle categories</span>
        <h2 class="d2" style="margin-top:12px">Find the right bundle for you</h2>
        {% render 'purelane-rule' %}
      </div>
      <div class="cats">
        <a class="glass cat rv" href="#combos">
          <span class="ph"><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span></span>
          <span class="txt"><h4>Kitchen bundle</h4><p>Grease, dishes &amp; more</p></span>
        </a>
        <a class="glass cat rv rv-d1" href="#combos">
          <span class="ph"><span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span></span>
          <span class="txt"><h4>Bathroom bundle</h4><p>Deep clean &amp; disinfect</p></span>
        </a>
        <a class="glass cat rv rv-d2" href="#combos">
          <span class="ph"><span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent"></span></span>
          <span class="txt"><h4>Laundry bundle</h4><p>Softer, fresher wash</p></span>
        </a>
        <a class="glass cat rv rv-d3" href="#combos">
          <span class="ph"><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span></span>
          <span class="txt"><h4>Hard water bundle</h4><p>Melt away limescale</p></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="sec" data-scene="4">
    <div class="wrap">
      <div class="glass trust rv">
        <div class="trust-i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <span>Plant derived<br>formulas</span>
        </div>
        <div class="trust-i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M4 8 6.5 3h11L20 8M9.5 12h5"/></svg>
          <span>Recyclable<br>packaging</span>
        </div>
        <div class="trust-i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
          <span>Safe for<br>kids &amp; pets</span>
        </div>
        <div class="trust-i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/></svg>
          <span>Made in<br>India</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Signup -->
  <section class="sec" data-scene="4">
    <div class="wrap">
      <div class="glass signup rv">
        <span class="kicker">Join the Purelane Club</span>
        <h2 class="d2" style="margin-top:12px">Get ₹100 off your first bundle</h2>
        <p class="lede" style="margin:0 auto">Plus first access to new launches and restocks.</p>
        <form onsubmit="return false">
          <input type="email" placeholder="your@email.com" aria-label="Email address" required>
          <button class="btn btn-primary" type="submit">Get my ₹100 off</button>
        </form>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Purelane bundle extras",
  "tag": "div",
  "class": "section-purelane-bundle-extras",
  "settings": [],
  "presets": [
    {
      "name": "Purelane bundle extras"
    }
  ]
}
{% endschema %}
